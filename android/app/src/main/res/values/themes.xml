<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LuxTicker" parent="android:Theme.Material.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:statusBarColor">@color/lux_wire_paper</item>
        <item name="android:navigationBarColor">@color/lux_wire_paper</item>
        <item name="android:windowBackground">@color/lux_wire_paper</item>
        <item name="android:colorBackground">@color/lux_wire_paper</item>
        <item name="android:colorPrimary">@color/lux_wire_orange</item>
        <item name="android:colorPrimaryDark">@color/lux_wire_accent_deep</item>
        <item name="android:colorAccent">@color/lux_wire_orange</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
