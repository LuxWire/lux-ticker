<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/lux_wire_paper"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/lux_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_lux_wire" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lux_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/jetbrains_mono_bold"
            android:maxLines="1"
            android:textColor="@color/lux_wire_ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lux_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subscribers"
            android:textColor="@color/lux_wire_orange"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lux_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/lux_wire_body"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
