<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lock_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/lux_ticker_shade_bg"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/lock_tape"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="marquee"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:fontFamily="@font/jetbrains_mono_bold"
        android:includeFontPadding="false"
        android:marqueeRepeatLimit="marquee_forever"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:textColor="@color/lux_ticker_shade_ink"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lock_btc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/jetbrains_mono_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/lux_ticker_shade_accent"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="4dp"
        android:layout_height="28dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:id="@+id/lock_accent"
        android:background="@color/lux_ticker_shade_accent"
        android:text="" />
</LinearLayout>
