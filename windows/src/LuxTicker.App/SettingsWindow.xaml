<Window x:Class="LuxTicker.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LuxWire Ticker Settings"
        Width="920"
        Height="700"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#F6F2E8"
        Foreground="#282622"
        FontFamily="Segoe UI"
        FontSize="13"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True">
    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D4A017"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#161412"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#D4A017"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#161412"/>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#282622"/>
            <Setter Property="Margin" Value="0,4,16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#282622"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#EFEADE"/>
            <Setter Property="Foreground" Value="#161412"/>
            <Setter Property="BorderBrush" Value="#D7D7DA"/>
            <Setter Property="CaretBrush" Value="#161412"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F7931A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#F7931A"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Nav" TargetType="Button">
            <Setter Property="Background" Value="#EFEADE"/>
            <Setter Property="Foreground" Value="#282622"/>
            <Setter Property="BorderBrush" Value="#D7D7DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0D48A"/>
                                <Setter Property="Foreground" Value="#161412"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D4A017"/>
                                <Setter Property="Foreground" Value="#161412"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#161412"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0D48A"/>
                                <Setter Property="Foreground" Value="#161412"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D4A017"/>
                                <Setter Property="Foreground" Value="#161412"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#161412"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D4A017"/>
                                <Setter Property="Foreground" Value="#161412"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D4A017"/>
                                <Setter Property="Foreground" Value="#161412"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Quiet" TargetType="Button">
            <Setter Property="Background" Value="#161412"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#161412"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#EFEADE"/>
            <Setter Property="Foreground" Value="#161412"/>
            <Setter Property="BorderBrush" Value="#D7D7DA"/>
            <Setter Property="MinHeight" Value="88"/>
            <Setter Property="MaxHeight" Value="160"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#EFEADE"/>
            <Setter Property="Foreground" Value="#161412"/>
            <Setter Property="BorderBrush" Value="#D7D7DA"/>
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#78787D"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16,14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Border Width="36" Height="36" Background="#F7931A" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="LW" Foreground="#F6F2E8" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Foreground="#282622"/>
                <TextBlock x:Name="VersionText" FontSize="13" Foreground="#55555A"/>
            </StackPanel>
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="Reset ALL settings to defaults" Click="ResetAll_Click" Style="{StaticResource Quiet}"/>
            <Button Content="Close" MinWidth="76" Click="Close_Click" Style="{StaticResource Quiet}"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#EFEADE" CornerRadius="4" Margin="0,0,12,0" Padding="8">
                <StackPanel>
                    <Button x:Name="NavTickers" Content="Tickers" Style="{StaticResource Nav}" Tag="Tickers" Click="Section_Click"/>
                    <Button x:Name="NavAppearance" Content="Appearance" Style="{StaticResource Nav}" Tag="Appearance" Click="Section_Click"/>
                    <Button x:Name="NavMotion" Content="Motion" Style="{StaticResource Nav}" Tag="Motion" Click="Section_Click"/>
                    <Button x:Name="NavPosition" Content="Position &amp; Dock" Style="{StaticResource Nav}" Tag="Position" Click="Section_Click"/>
                    <Button x:Name="NavCharts" Content="Charts" Style="{StaticResource Nav}" Tag="Charts" Click="Section_Click"/>
                    <Button x:Name="NavLux" Content="LuxWire" Style="{StaticResource Nav}" Tag="Lux" Click="Section_Click"/>
                    <Button x:Name="NavAccount" Content="Account" Style="{StaticResource Nav}" Tag="Account" Click="Section_Click"/>
                    <Button x:Name="NavUpdates" Content="Updates" Style="{StaticResource Nav}" Tag="Updates" Click="Section_Click"/>
                    <Button x:Name="NavAbout" Content="About" Style="{StaticResource Nav}" Tag="About" Click="Section_Click"/>
                </StackPanel>
            </Border>
            <DockPanel Grid.Column="1">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8" ToolTip="Search settings"
                         Foreground="#161412" CaretBrush="#161412" Background="#EFEADE" BorderBrush="#D7D7DA"
                         TextChanged="Search_Changed"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,24,0">
                    <StackPanel>
                        <StackPanel x:Name="PageTickers" Tag="Tickers">
                            <StackPanel Tag="Tickers|Add ticker" Margin="0,0,0,8">
                                <TextBlock Text="Add ticker" FontWeight="SemiBold" Foreground="#282622" Margin="0,0,0,6"/>
                                <DockPanel>
                                    <Button x:Name="AddButton" DockPanel.Dock="Right" Content="Add ticker" Click="Add_Click" Margin="0"/>
                                    <TextBox x:Name="SymbolBox" ToolTip="Symbol" Foreground="#161412" CaretBrush="#161412"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Tag="Tickers|Symbol order">
                                <TextBlock x:Name="EmptyText" Text="No tickers yet. Add one above." Foreground="#78787D" Margin="0,0,0,6" Visibility="Collapsed"/>
                                <ListBox x:Name="SymbolList" DisplayMemberPath="Symbol"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Move up" Click="MoveUp_Click"/>
                                    <Button Content="Move down" Click="MoveDown_Click"/>
                                    <Button Content="Remove ticker" Click="Remove_Click" Style="{StaticResource Quiet}"/>
                                </StackPanel>
                                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#C0392B" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Tag="Tickers|PRE" Margin="0,10,0,0">
                                <CheckBox x:Name="PreBox" Content="PRE" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                <TextBlock Style="{StaticResource Help}" Text="Shows PRE before the open. On by default."/>
                            </StackPanel>
                            <StackPanel Tag="Tickers|After hours">
                                <CheckBox x:Name="AhBox" Content="After hours" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                <TextBlock Style="{StaticResource Help}" Text="Shows AH after the close. Off by default."/>
                            </StackPanel>
                            <StackPanel Tag="Tickers|Keep BTC fixed">
                                <CheckBox x:Name="PinBox" Content="Keep BTC fixed" Checked="Option_Changed" Unchecked="Option_Changed"/>
                            </StackPanel>
                            <StackPanel Tag="Tickers|Refresh" Margin="0,8,0,0">
                                <Button Content="Refresh" HorizontalAlignment="Left" Click="Refresh_Click"/>
                            </StackPanel>
                            <StackPanel Tag="Tickers|Price alerts" Margin="0,12,0,0">
                                <TextBlock Text="Price alerts" FontWeight="SemiBold" Foreground="#282622" Margin="0,0,0,6"/>
                                <DockPanel Margin="0,0,0,6">
                                    <Button x:Name="AlertAdd" DockPanel.Dock="Right" Content="Add alert" Click="AddAlert_Click" Margin="0"/>
                                    <TextBox x:Name="AlertSymbol" Width="90" DockPanel.Dock="Left" ToolTip="Symbol" Foreground="#161412"/>
                                    <TextBox x:Name="AlertPrice" Width="90" DockPanel.Dock="Left" ToolTip="Price" Foreground="#161412"/>
                                    <ComboBox x:Name="AlertSide" Width="90" SelectedIndex="0">
                                        <ComboBoxItem Content="Above"/>
                                        <ComboBoxItem Content="Below"/>
                                    </ComboBox>
                                </DockPanel>
                                <ListBox x:Name="AlertList"/>
                                <Button Content="Remove alert" HorizontalAlignment="Left" Margin="0,8,0,0" Click="RemoveAlert_Click" Style="{StaticResource Quiet}"/>
                                <TextBlock x:Name="AlertError" TextWrapping="Wrap" Foreground="#C0392B" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Button Content="Reset this section to defaults" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ResetTickers_Click" Style="{StaticResource Quiet}"/>
                        </StackPanel>

                        <StackPanel x:Name="PageAppearance" Tag="Appearance" Visibility="Collapsed">
                            <StackPanel Tag="Appearance|Ticker look">
                                <TextBlock Text="Ticker look" FontWeight="SemiBold" Foreground="#282622" Margin="0,0,0,6"/>
                                <TextBlock Style="{StaticResource Help}" Text="Wall Street is the default on a new install: a dark board with amber and green, like an exchange tape. NYSE, Nasdaq, Cboe, NYSE American, NYSE Arca, IEX, MIAX, and MEMX are here too. A look you already saved stays until you pick another."/>
                                <ComboBox x:Name="LookBox" Width="220" HorizontalAlignment="Left" SelectionChanged="Look_Changed"/>
                            </StackPanel>
                            <StackPanel Tag="Appearance|Font" Margin="0,10,0,0">
                                <TextBlock Text="Font" FontWeight="SemiBold" Foreground="#282622" Margin="0,0,0,6"/>
                                <TextBlock Style="{StaticResource Help}" Text="Recommended ticker fonts are listed first. Only faces installed on this PC are shown. Cascadia Mono is included."/>
                                <ComboBox x:Name="FontBox" HorizontalAlignment="Stretch" Margin="0,0,0,8" SelectionChanged="Speed_Changed"/>
                            </StackPanel>
                            <StackPanel Tag="Appearance|Font size">
                                <TextBlock Text="Font size" Margin="0,0,0,4" Foreground="#282622"/>
                                <DockPanel>
                                    <TextBlock x:Name="TextSizeLabel" DockPanel.Dock="Right" Width="42" TextAlignment="Right" VerticalAlignment="Center" Text="100%"/>
                                    <Slider x:Name="TextSlider" Minimum="0.8" Maximum="1.6" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Tag="Appearance|Symbol color" Margin="0,10,0,0">
                                <TextBlock Text="Symbol color" Margin="0,0,0,4" Foreground="#282622"/>
                                <TextBlock Style="{StaticResource Help}" Text="Ticker symbol. Wall Street uses amber. Lux Wire paper uses burnt orange."/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Reset" Click="ResetSymbolColor_Click" Style="{StaticResource Quiet}" Margin="8,0,0,0"/>
                                    <Border x:Name="SymbolSwatch" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" BorderBrush="#D7D7DA" BorderThickness="1" Background="#CC5500" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SymbolColorBox" Width="92" DockPanel.Dock="Left" Text="#CC5500" TextChanged="Color_Changed" ToolTip="Symbol color"/>
                                    <ComboBox x:Name="SymbolPreset" Width="160" HorizontalAlignment="Left" SelectionChanged="Preset_Changed">
                                        <ComboBoxItem Content="Burnt orange" Tag="#CC5500"/>
                                        <ComboBoxItem Content="Lux Wire orange" Tag="#F7931A"/>
                                        <ComboBoxItem Content="Ink" Tag="#161412"/>
                                        <ComboBoxItem Content="White" Tag="#FFFFFF"/>
                                        <ComboBoxItem Content="Green" Tag="#1B7A3A"/>
                                        <ComboBoxItem Content="Red" Tag="#C0392B"/>
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Tag="Appearance|Price color" Margin="0,10,0,0">
                                <TextBlock Text="Price color" Margin="0,0,0,4" Foreground="#282622"/>
                                <TextBlock Style="{StaticResource Help}" Text="The price. Wall Street uses an LED green. Lux Wire paper uses ink."/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Reset" Click="ResetPriceColor_Click" Style="{StaticResource Quiet}" Margin="8,0,0,0"/>
                                    <Border x:Name="PriceSwatch" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" BorderBrush="#D7D7DA" BorderThickness="1" Background="#161412" VerticalAlignment="Center"/>
                                    <TextBox x:Name="PriceColorBox" Width="92" DockPanel.Dock="Left" Text="#161412" TextChanged="Color_Changed" ToolTip="Price color"/>
                                    <ComboBox x:Name="PricePreset" Width="160" HorizontalAlignment="Left" SelectionChanged="Preset_Changed">
                                        <ComboBoxItem Content="Burnt orange" Tag="#CC5500"/>
                                        <ComboBoxItem Content="Lux Wire orange" Tag="#F7931A"/>
                                        <ComboBoxItem Content="Ink" Tag="#161412"/>
                                        <ComboBoxItem Content="White" Tag="#FFFFFF"/>
                                        <ComboBoxItem Content="Green" Tag="#1B7A3A"/>
                                        <ComboBoxItem Content="Red" Tag="#C0392B"/>
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Tag="Appearance|Change up" Margin="0,10,0,0">
                                <TextBlock Text="Change up" Margin="0,0,0,4" Foreground="#282622"/>
                                <TextBlock Style="{StaticResource Help}" Text="A rising change. Green is the default."/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Reset" Click="ResetUpColor_Click" Style="{StaticResource Quiet}" Margin="8,0,0,0"/>
                                    <Border x:Name="UpSwatch" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" BorderBrush="#D7D7DA" BorderThickness="1" Background="#1B7A3A" VerticalAlignment="Center"/>
                                    <TextBox x:Name="UpColorBox" Width="92" DockPanel.Dock="Left" Text="#1B7A3A" TextChanged="Color_Changed" ToolTip="Change up"/>
                                    <ComboBox x:Name="UpPreset" Width="160" HorizontalAlignment="Left" SelectionChanged="Preset_Changed">
                                        <ComboBoxItem Content="Burnt orange" Tag="#CC5500"/>
                                        <ComboBoxItem Content="Lux Wire orange" Tag="#F7931A"/>
                                        <ComboBoxItem Content="Ink" Tag="#161412"/>
                                        <ComboBoxItem Content="White" Tag="#FFFFFF"/>
                                        <ComboBoxItem Content="Green" Tag="#1B7A3A"/>
                                        <ComboBoxItem Content="Red" Tag="#C0392B"/>
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Tag="Appearance|Change down" Margin="0,10,0,0">
                                <TextBlock Text="Change down" Margin="0,0,0,4" Foreground="#282622"/>
                                <TextBlock Style="{StaticResource Help}" Text="A falling change. Red is the default."/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Reset" Click="ResetDownColor_Click" Style="{StaticResource Quiet}" Margin="8,0,0,0"/>
                                    <Border x:Name="DownSwatch" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" BorderBrush="#D7D7DA" BorderThickness="1" Background="#C0392B" VerticalAlignment="Center"/>
                                    <TextBox x:Name="DownColorBox" Width="92" DockPanel.Dock="Left" Text="#C0392B" TextChanged="Color_Changed" ToolTip="Change down"/>
                                    <ComboBox x:Name="DownPreset" Width="160" HorizontalAlignment="Left" SelectionChanged="Preset_Changed">
                                        <ComboBoxItem Content="Burnt orange" Tag="#CC5500"/>
                                        <ComboBoxItem Content="Lux Wire orange" Tag="#F7931A"/>
                                        <ComboBoxItem Content="Ink" Tag="#161412"/>
                                        <ComboBoxItem Content="White" Tag="#FFFFFF"/>
                                        <ComboBoxItem Content="Green" Tag="#1B7A3A"/>
                                        <ComboBoxItem Content="Red" Tag="#C0392B"/>
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Tag="Appearance|Spacing" Margin="0,10,0,0">
                                <TextBlock Text="Spacing" Margin="0,0,0,4" Foreground="#282622"/>
                                <TextBlock Style="{StaticResource Help}" Text="Gap between tickers. 1× is the usual spacing."/>
                                <DockPanel>
                                    <TextBlock x:Name="GapLabel" DockPanel.Dock="Right" Width="42" TextAlignment="Right" VerticalAlignment="Center" Text="1×"/>
                                    <Slider x:Name="GapSlider" Minimum="0" Maximum="3" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Tag="Appearance|Background color" Margin="0,10,0,0">
                                <TextBlock Text="Background color" Margin="0,0,0,4" Foreground="#282622"/>
                                <TextBlock Style="{StaticResource Help}" Text="The ticker board. Any hex or RGB is allowed. New installs use the Wall Street board. A color you already saved stays. Opacity still applies."/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Reset" Click="ResetBackgroundColor_Click" Style="{StaticResource Quiet}" Margin="8,0,0,0"/>
                                    <Button DockPanel.Dock="Right" Content="Custom…" Click="CustomBackground_Click" Margin="8,0,0,0" ToolTip="Pick any hex or RGB"/>
                                    <Border x:Name="BackgroundSwatch" Width="22" Height="22" DockPanel.Dock="Left" Margin="0,0,8,0" BorderBrush="#D7D7DA" BorderThickness="1" Background="#F6F2E8" VerticalAlignment="Center"/>
                                    <TextBox x:Name="BackgroundColorBox" Width="92" DockPanel.Dock="Left" Text="#F6F2E8" TextChanged="Color_Changed" ToolTip="Background color"/>
                                    <ComboBox x:Name="BackgroundPreset" Width="160" HorizontalAlignment="Left" SelectionChanged="Preset_Changed">
                                        <ComboBoxItem Content="Paper" Tag="#F6F2E8"/>
                                        <ComboBoxItem Content="Panel" Tag="#EFEADE"/>
                                        <ComboBoxItem Content="Ink" Tag="#161412"/>
                                        <ComboBoxItem Content="White" Tag="#FFFFFF"/>
                                        <ComboBoxItem Content="Lux Wire orange" Tag="#F7931A"/>
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Tag="Appearance|Opacity" Margin="0,10,0,0">
                                <TextBlock Text="Opacity" Margin="0,0,0,4" Foreground="#282622"/>
                                <TextBlock Style="{StaticResource Help}" Text="How solid the background color is. 100% is fully opaque. The prices stay solid."/>
                                <DockPanel>
                                    <TextBlock x:Name="OpacityLabel" DockPanel.Dock="Right" Width="42" TextAlignment="Right" VerticalAlignment="Center" Text="100%"/>
                                    <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Tag="Appearance|Percent">
                                <CheckBox x:Name="PercentBox" Content="Percent" Checked="Option_Changed" Unchecked="Option_Changed"/>
                            </StackPanel>
                            <StackPanel Tag="Appearance|Sparklines">
                                <CheckBox x:Name="SparkBox" Content="Sparklines" Checked="Option_Changed" Unchecked="Option_Changed"/>
                            </StackPanel>
                            <StackPanel Tag="Appearance|Compact" Margin="0,8,0,0">
                                <TextBlock Text="Compact" Margin="0,0,0,4" Foreground="#282622"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="CompactRadio" Content="Compact" Checked="Option_Changed"/>
                                    <RadioButton x:Name="ExpandedRadio" Content="Expanded" Checked="Option_Changed"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Reset this section to defaults" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ResetAppearance_Click" Style="{StaticResource Quiet}"/>
                        </StackPanel>

                        <StackPanel x:Name="PageMotion" Tag="Motion" Visibility="Collapsed">
                            <StackPanel Tag="Motion|Scroll">
                                <CheckBox x:Name="ScrollBox" Content="Scroll" Checked="Option_Changed" Unchecked="Option_Changed"/>
                            </StackPanel>
                            <StackPanel Tag="Motion|Live updates" Margin="0,8,0,0">
                                <CheckBox x:Name="LiveBox" Content="Live updates while scrolling" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                <TextBlock Style="{StaticResource Help}" Text="On, prices change in place while the tape moves. An uptick flashes green and a downtick flashes red. On for a new install. A ticker you already set up stays off until you turn this on."/>
                            </StackPanel>
                            <StackPanel Tag="Motion|Speed" Margin="0,8,0,0">
                                <TextBlock Text="Speed" Margin="0,0,0,4" Foreground="#282622"/>
                                <DockPanel>
                                    <TextBlock x:Name="SpeedLabel" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center" Text="90 px/s"/>
                                    <Slider x:Name="SpeedSlider" Minimum="24" Maximum="280" Value="90" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Tag="Motion|Direction" Margin="0,10,0,0">
                                <TextBlock Text="Direction" Margin="0,0,0,4" Foreground="#282622"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="LeftRadio" Content="Left" Checked="Option_Changed"/>
                                    <RadioButton x:Name="RightRadio" Content="Right" Checked="Option_Changed"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Tag="Motion|Loop">
                                <CheckBox x:Name="LoopBox" Content="Loop" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                <TextBlock Style="{StaticResource Help}" Text="On, the strip repeats. Off, it scrolls one pass and holds."/>
                            </StackPanel>
                            <Button Content="Reset this section to defaults" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ResetMotion_Click" Style="{StaticResource Quiet}"/>
                        </StackPanel>

                        <StackPanel x:Name="PagePosition" Tag="Position" Visibility="Collapsed">
                            <StackPanel Tag="Position|Always on top">
                                <CheckBox x:Name="TopBox" Content="Always on top" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                <TextBlock Style="{StaticResource Help}" Text="On by default. The bar stays above other windows, including after Alt+Tab and full-screen apps."/>
                            </StackPanel>
                            <StackPanel Tag="Position|Above the taskbar" Margin="0,8,0,0">
                                <RadioButton x:Name="AboveRadio" GroupName="Dock" Content="Above the taskbar" Checked="Option_Changed"/>
                                <TextBlock Style="{StaticResource Help}" Text="The bar sits directly above the taskbar. Maximized windows stop there. It does not cover Start."/>
                            </StackPanel>
                            <StackPanel Tag="Position|Top of the screen">
                                <RadioButton x:Name="TopRadio" GroupName="Dock" Content="Top of the screen" Checked="Option_Changed"/>
                            </StackPanel>
                            <StackPanel Tag="Position|Vertical position" Margin="0,10,0,0">
                                <TextBlock Text="Vertical position" Margin="0,0,0,4" Foreground="#282622"/>
                                <TextBlock Style="{StaticResource Help}" Text="0 keeps the bar on the dock. Negative moves it toward the taskbar or screen edge. Positive moves it into the desktop. Range is −240 to +640."/>
                                <DockPanel>
                                    <TextBlock x:Name="OffsetLabel" DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center" Text="0"/>
                                    <Slider x:Name="OffsetSlider" Minimum="-240" Maximum="640" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Tag="Position|Monitor" Margin="0,10,0,0">
                                <TextBlock Text="Monitor" Margin="0,0,0,4" Foreground="#282622"/>
                                <ComboBox x:Name="MonitorBox" Width="280" HorizontalAlignment="Left" SelectionChanged="Speed_Changed"/>
                            </StackPanel>
                            <StackPanel Tag="Position|Click-through" Margin="0,8,0,0">
                                <CheckBox x:Name="ClickBox" Content="Click-through" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                <TextBlock Style="{StaticResource Help}" Text="Clicks pass through the scrolling prices. Chart and Settings stay clickable. Turn it off here, or right-click the tray icon."/>
                            </StackPanel>
                            <StackPanel Tag="Position|Start with Windows" Margin="0,8,0,0">
                                <CheckBox x:Name="StartBox" Content="Start with Windows" Checked="Option_Changed" Unchecked="Option_Changed"/>
                            </StackPanel>
                            <Button Content="Reset this section to defaults" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ResetPosition_Click" Style="{StaticResource Quiet}"/>
                        </StackPanel>

                        <StackPanel x:Name="PageCharts" Tag="Charts" Visibility="Collapsed">
                            <StackPanel Tag="Charts|Open chart">
                                <Button Content="Open chart" HorizontalAlignment="Left" Click="OpenChart_Click"/>
                                <TextBlock Style="{StaticResource Help}" Text="Opens the chart window."/>
                            </StackPanel>
                            <StackPanel Tag="Charts|Default range" Margin="0,10,0,0">
                                <TextBlock Text="Default range" FontWeight="SemiBold" Foreground="#282622" Margin="0,0,0,6"/>
                                <ComboBox x:Name="RangeBox" Width="140" HorizontalAlignment="Left" SelectionChanged="Speed_Changed">
                                    <ComboBoxItem Content="1H"/>
                                    <ComboBoxItem Content="1D"/>
                                    <ComboBoxItem Content="1W"/>
                                    <ComboBoxItem Content="1M"/>
                                    <ComboBoxItem Content="6M"/>
                                    <ComboBoxItem Content="YTD"/>
                                    <ComboBoxItem Content="1Y"/>
                                    <ComboBoxItem Content="ALL"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Tag="Charts|Line Candles" Margin="0,10,0,0">
                                <TextBlock Text="Line or Candles" Margin="0,0,0,4" Foreground="#282622"/>
                                <ComboBox x:Name="StyleBox" Width="140" HorizontalAlignment="Left" SelectionChanged="Speed_Changed">
                                    <ComboBoxItem Content="Line"/>
                                    <ComboBoxItem Content="Candles"/>
                                </ComboBox>
                                <TextBlock Style="{StaticResource Help}" Text="Candles show open, high, low, and close."/>
                            </StackPanel>
                            <StackPanel Tag="Charts|Crosshair">
                                <CheckBox x:Name="CrosshairBox" Content="Crosshair" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                <TextBlock Style="{StaticResource Help}" Text="Click or drag the chart to read the price, or open, high, low, and close, in Eastern time."/>
                            </StackPanel>
                            <Button Content="Reset this section to defaults" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ResetCharts_Click" Style="{StaticResource Quiet}"/>
                        </StackPanel>

                        <StackPanel x:Name="PageLux" Tag="Lux" Visibility="Collapsed">
                            <StackPanel Tag="LuxWire|LuxWire post alerts">
                                <TextBlock Text="LuxWire post alerts" FontWeight="SemiBold" Foreground="#282622" Margin="0,0,0,6"/>
                                <CheckBox x:Name="LuxBox" Content="LuxWire post alerts" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                <TextBlock Style="{StaticResource Help}" Text="On, the app checks @LuxWire while it is running. The first check marks current posts seen and does not toast."/>
                            </StackPanel>
                            <StackPanel x:Name="PollPanel" Tag="LuxWire|Poll" Margin="0,8,0,0">
                                <TextBlock Text="Poll" Margin="0,0,0,4" Foreground="#282622"/>
                                <ComboBox x:Name="PollBox" Width="180" HorizontalAlignment="Left" SelectionChanged="Speed_Changed">
                                    <ComboBoxItem Content="Every 2 minutes"/>
                                    <ComboBoxItem Content="Every 3 minutes"/>
                                    <ComboBoxItem Content="Every 5 minutes"/>
                                </ComboBox>
                            </StackPanel>
                            <Button Content="Reset this section to defaults" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ResetLux_Click" Style="{StaticResource Quiet}"/>
                        </StackPanel>

                        <StackPanel x:Name="PageAccount" Tag="Account" Visibility="Collapsed">
                            <TextBlock Text="Account" FontWeight="SemiBold" Foreground="#282622" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource Help}" Text="Optional. The ticker works without an account. Signed in, settings and the watchlist sync."/>
                            <TextBlock x:Name="AccountStatus" TextWrapping="Wrap" Foreground="#55555A" Margin="0,8,0,8"/>
                            <StackPanel x:Name="SignedOutPanel" Tag="Account|Create account Sign in Forgot password Username">
                                <TextBlock Text="Email or username" Foreground="#282622" Margin="0,0,0,4"/>
                                <TextBox x:Name="AccountIdBox" ToolTip="Email or username"/>
                                <TextBlock Text="Password" Foreground="#282622" Margin="0,8,0,4"/>
                                <PasswordBox x:Name="AccountPassword" Margin="0,0,8,0" Padding="8,5"
                                             Background="#EFEADE" Foreground="#161412" BorderBrush="#D7D7DA" CaretBrush="#161412"/>
                                <TextBlock Text="Username, optional, for a new account" Foreground="#282622" Margin="0,8,0,4"/>
                                <TextBox x:Name="AccountNewUsername" ToolTip="Username"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Create account" Click="CreateAccount_Click"/>
                                    <Button Content="Sign in" Click="SignInAccount_Click" Style="{StaticResource Quiet}"/>
                                    <Button Content="Forgot password" Click="ForgotPassword_Click" Style="{StaticResource Quiet}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="SignedInPanel" Visibility="Collapsed" Tag="Account|Sign out Delete account Username">
                                <TextBlock x:Name="AccountSignedEmail" FontWeight="SemiBold" Foreground="#282622"/>
                                <TextBlock x:Name="AccountTierText" Foreground="#55555A" Margin="0,4,0,0"/>
                                <TextBlock x:Name="AccountPerkText" TextWrapping="Wrap" Foreground="#161412" Margin="0,6,0,0"
                                           Text="Signed-in perk: settings and the watchlist stay with the account."/>
                                <TextBlock Text="Username" Foreground="#282622" Margin="0,10,0,4"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Save username" Click="SaveUsername_Click"/>
                                    <TextBox x:Name="AccountUsernameBox" ToolTip="Username"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Sign out" Click="SignOutAccount_Click" Style="{StaticResource Quiet}"/>
                                    <Button Content="Delete account" Click="DeleteAccount_Click" Style="{StaticResource Quiet}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="OAuthPanel" Visibility="Collapsed" Margin="0,14,0,0" Tag="Account|Continue with Google Continue with X">
                                <TextBlock Text="Or continue with" Foreground="#55555A" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Continue with Google" Click="GoogleAccount_Click" Style="{StaticResource Quiet}"/>
                                    <Button Content="Continue with X" Click="XAccount_Click" Style="{StaticResource Quiet}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,14,0,0" Tag="Account|Privacy Terms">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Privacy" Click="Privacy_Click" Style="{StaticResource Quiet}"/>
                                    <Button Content="Terms" Click="Terms_Click" Style="{StaticResource Quiet}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="PageUpdates" Tag="Updates" Visibility="Collapsed">
                            <StackPanel Tag="Updates|Check for updates">
                                <TextBlock x:Name="UpdatesVersion" Text="LuxWire Ticker" FontWeight="SemiBold" Foreground="#282622" Margin="0,0,0,6"/>
                                <Button x:Name="CheckUpdatesButton" Content="Check for updates" HorizontalAlignment="Left" Click="CheckUpdates_Click"/>
                                <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Foreground="#55555A" Margin="0,8,0,0"/>
                                <TextBlock Style="{StaticResource Help}" Margin="0,8,0,0" Text="A newer Setup installs over this one and keeps your settings."/>
                            </StackPanel>
                            <StackPanel Tag="Updates|What's new" Margin="0,12,0,0">
                                <TextBlock Text="What's new" FontWeight="SemiBold" Foreground="#282622" Margin="0,0,0,6"/>
                                <StackPanel x:Name="WhatsNewHost"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="PageAbout" Tag="About" Visibility="Collapsed">
                            <TextBlock x:Name="AboutTitle" Text="LuxWire Ticker" FontWeight="SemiBold" FontSize="16" Foreground="#282622"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#161412" Text="A scrolling stock and crypto ticker for the Windows desktop."/>
                            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#282622" Text="LuxWire covers Bitcoin, treasury companies, and the market around them."/>
                            <StackPanel Tag="About|Follow on X Subscribe" Margin="0,14,0,0">
                                <TextBlock TextWrapping="Wrap" Foreground="#161412" Text="Follow @LuxWire on X for Bitcoin news, treasury company buys, and market moves."/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Follow on X" Click="Follow_Click"/>
                                    <Button Content="Subscribe" Click="Subscribe_Click" Style="{StaticResource Quiet}" Tag="About|Subscribe"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Tag="About|Privacy Terms" Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Privacy" Click="Privacy_Click" Style="{StaticResource Quiet}"/>
                                    <Button Content="Terms" Click="Terms_Click" Style="{StaticResource Quiet}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
