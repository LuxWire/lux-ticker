<Window x:Class="LuxTicker.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit tickers"
        Width="480"
        Height="580"
        MinWidth="400"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="#141414"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI"
        FontSize="13"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E0E0E"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="#FFB000"/>
            <Setter Property="SelectionBrush" Value="#FFB000"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFB000"/>
                                <Setter Property="Foreground" Value="#141414"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#242424"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Edit tickers" FontSize="18" FontWeight="SemiBold" Foreground="#FFB000" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#9A9A9A" Margin="0,0,0,10"
                   Text="Add a symbol and an optional label. BTC uses the Coinbase feed. Everything else is checked against Yahoo before it is added. Drag a row, or use the buttons, to reorder."/>
        <TextBlock x:Name="PathText" DockPanel.Dock="Bottom" Foreground="#6E6E6E" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Foreground="#FF6B6B" TextWrapping="Wrap" MinHeight="18" Margin="0,8,0,0"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Up" Width="64" Margin="0,0,6,0" Click="Up_Click"/>
            <Button Content="Down" Width="64" Margin="0,0,6,0" Click="Down_Click"/>
            <Button Content="Remove" Width="76" Margin="0,0,6,0" Click="Remove_Click"/>
            <Button Content="Reset to default list" Margin="12,0,0,0" Click="Reset_Click"/>
        </StackPanel>
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Symbol" Foreground="#9A9A9A" FontSize="11"/>
            <TextBlock Grid.Column="1" Text="Label (optional)" Foreground="#9A9A9A" FontSize="11" Margin="8,0,8,0"/>
            <TextBox x:Name="SymbolBox" Grid.Row="1" Margin="0,4,0,0" KeyDown="SymbolBox_KeyDown"/>
            <TextBox x:Name="LabelBox" Grid.Row="1" Grid.Column="1" Margin="8,4,8,0" KeyDown="SymbolBox_KeyDown"/>
            <Button x:Name="AddButton" Grid.Row="1" Grid.Column="2" Content="Add" MinWidth="76" Margin="0,4,0,0" Click="Add_Click"/>
        </Grid>
        <ListBox x:Name="SymbolList"
                 Background="#0E0E0E"
                 Foreground="#F2F2F2"
                 BorderBrush="#333333"
                 BorderThickness="1"
                 AllowDrop="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="List_PreviewMouseMove"
                 DragOver="List_DragOver"
                 Drop="List_Drop"
                 KeyDown="List_KeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayLabel}" FontFamily="Consolas" FontWeight="Bold" Foreground="#FFB000"/>
                        <TextBlock Grid.Column="1" Text="{Binding EditorDetail}" FontFamily="Consolas" Foreground="#9A9A9A"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
