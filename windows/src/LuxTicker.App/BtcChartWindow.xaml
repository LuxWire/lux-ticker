<Window x:Class="LuxTicker.BtcChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LuxTicker"
        Title="Chart"
        Width="880"
        Height="560"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F6F2E8"
        Foreground="#282622"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#EFEADE"/>
            <Setter Property="Foreground" Value="#282622"/>
            <Setter Property="BorderBrush" Value="#D7D7DA"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="6,0,12,0"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Background" Value="#EFEADE"/>
            <Setter Property="Foreground" Value="#161412"/>
            <Setter Property="BorderBrush" Value="#D7D7DA"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="18,14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Border Width="36" Height="36" Background="#F7931A" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="LW" Foreground="#F6F2E8" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="SymbolText" Text="BTC/USD" FontSize="13" Foreground="#55555A"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PriceText" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="#161412"/>
                    <TextBlock x:Name="ChangeText" Margin="10,6,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>
        <TextBox x:Name="SymbolSearch"
                 DockPanel.Dock="Top"
                 Margin="0,0,0,6"
                 Padding="8,6"
                 Background="#EFEADE"
                 Foreground="#161412"
                 CaretBrush="#161412"
                 BorderBrush="#D7D7DA"
                 ToolTip="Search any symbol"
                 AutomationProperties.Name="Search symbol"
                 TextChanged="SymbolSearch_Changed"
                 PreviewKeyDown="SymbolSearch_KeyDown"
                 GotFocus="SymbolSearch_GotFocus"/>
        <ListBox x:Name="SuggestList"
                 DockPanel.Dock="Top"
                 MaxHeight="168"
                 Margin="0,0,0,8"
                 Visibility="Collapsed"
                 Background="#EFEADE"
                 Foreground="#161412"
                 BorderBrush="#D7D7DA"
                 MouseLeftButtonUp="Suggest_Click"
                 PreviewKeyDown="Suggest_KeyDown">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="#161412"/>
                    <Setter Property="Background" Value="#EFEADE"/>
                    <Setter Property="Padding" Value="8,4"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" x:Name="PresetBar" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="LineButton" Content="Line" MinWidth="72" Click="Line_Click" ToolTip="Close price"/>
            <Button x:Name="CandlesButton" Content="Candles" MinWidth="84" Click="Candles_Click" ToolTip="Open, high, low, close"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" x:Name="CustomPanel" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,2,0"/>
            <DatePicker x:Name="FromDate"/>
            <TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,2,0"/>
            <DatePicker x:Name="ToDate"/>
            <Button Content="Apply" Click="ApplyCustom_Click" Background="#F7931A" Foreground="#FFFFFF" BorderBrush="#F7931A"/>
        </StackPanel>
        <TextBlock x:Name="CaptionText" DockPanel.Dock="Top" Foreground="#55555A" Margin="0,0,0,8"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="RetryButton" DockPanel.Dock="Right" Content="Try again" Click="Retry_Click" Visibility="Collapsed" Background="#161412" Foreground="#FFFFFF" BorderBrush="#161412" Margin="8,0,0,0"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#78787D" TextWrapping="Wrap"/>
        </DockPanel>
        <Border Background="#F6F2E8" BorderBrush="#D7D7DA" BorderThickness="1" CornerRadius="4">
            <Grid>
                <local:BtcChartPlot x:Name="Plot" Margin="4"/>
                <TextBlock x:Name="EmptyText"
                           Text="Loading Bitcoin prices…"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="24"
                           Foreground="#161412"
                           FontSize="15"/>
            </Grid>
        </Border>
    </DockPanel>
</Window>
